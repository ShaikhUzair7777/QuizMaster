# QuizMaster environment template. Copy to a private .env or set these as
# environment variables for Tomcat. Replace every placeholder before use.

# Supabase project URL, for example https://<project-ref>.supabase.co
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase legacy anon JWT or new publishable API key
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Supabase legacy service_role JWT or new secret API key; server-side only
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# Optional application secret (not currently required by application code)
APP_SECRET=generate-a-random-secret

# Gemini API key (server-side only; never expose it to browser code)
GEMINI_API_KEY=your-gemini-api-key
# Optional model override. The default uses the supported generateContent API model.
GEMINI_MODEL=gemini-2.5-flash
